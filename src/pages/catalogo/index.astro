---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { products } from '../../data/products';
---

<Layout>
  <section class="page-intro wrap mx-auto w-11/12 max-w-5xl text-center pt-20 pb-8 [&_h1]:text-8xl [&_h1]:mb-7 [&_>_p:not(.eyebrow)]:text-sm [&_>_p:not(.eyebrow)]:leading-loose [&_>_p:not(.eyebrow)]:text-muted [&_.button]:mt-5 max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-14 max-sm:pb-5 max-sm:[&_h1]:text-5xl max-sm:[&_h1]:leading-none max-sm:[&_>_p:not(.eyebrow)]:text-sm">
    <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
      PIEZAS ÚNICAS. EMOCIONES INFINITAS.
    </p>
    <h1>
      Nuestro jardín
      <br />
      <em>de emociones.</em>
    </h1>
    <p>
      Explora una inspiración para tu próximo gesto.
      <br />
      Cada creación florece de una forma distinta.
    </p>
  </section>
  <section aria-labelledby="catalog-title" class="catalog-page wrap section mx-auto w-11/12 max-w-5xl pt-10 pb-25 [&_>_.small-label]:text-xs max-xl:w-11/12 max-lg:py-20 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-6 max-sm:pb-15">
    <h2 id="catalog-title" class="sr-only">Colección de ramos y arreglos florales</h2>
    <div
      class="catalog-filters relative gap-8 flex justify-center flex-wrap mb-10 [&_button]:py-2 [&_button]:px-0 [&_button]:text-sm [&_button]:border-b-2 [&_button]:border-solid [&_button]:border-b-transparent [&_button]:text-muted [&:not([data-filter-indicator])_button[aria-pressed='true']]:border-accent [&_button[aria-pressed='true']]:text-ink max-sm:gap-y-3.5 max-sm:gap-x-6 max-sm:mb-8 max-sm:[&_button]:text-xs"
      role="group"
      aria-label="Filtrar colección"
    >
      {[
        'Todas',
        'Ramos franceses',
        'De temporada',
        'En macetero',
        'En florero',
      ].map((c, i) => (
        <button data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>
          {c}
        </button>
      ))}
    </div>
    <p
      id="catalog-count"
      class="small-label text-xs font-medium tracking-widest leading-relaxed"
      aria-live="polite"
    >
      {products.length} COMPOSICIONES PARA INSPIRARTE
    </p>
    <div class="product-grid catalog-grid gap-8 grid grid-cols-4 mt-9 max-xl:gap-6 max-lg:gap-5 max-sm:grid-cols-2 max-sm:gap-y-9 max-sm:gap-x-5 max-sm:mt-6">
      {products.map((product, index) => (
        <ProductCard product={product} index={index} />
      ))}
    </div>
    <p class="catalog-note mx-0 text-center text-xs text-muted mt-10 mb-0 max-sm:text-xs max-sm:leading-relaxed max-sm:mt-7">
      Fotografías de Frisson y propuestas ilustrativas identificadas en cada
      pieza. Flores, tamaños, presentación y precio se confirman al coordinar tu
      pedido.
    </p>
  </section>
  <FinalCTA />
</Layout>
