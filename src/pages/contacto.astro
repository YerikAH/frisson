---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DeliverySection from '../components/DeliverySection.astro';
import FAQ from '../components/FAQ.astro';
import SocialActions from '../components/SocialActions.astro';
---

<Layout>
  <section class="page-intro wrap mx-auto w-11/12 max-w-5xl text-center pt-20 pb-8 [&_h1]:text-8xl [&_h1]:mb-7 [&_>_p:not(.eyebrow)]:text-sm [&_>_p:not(.eyebrow)]:leading-loose [&_>_p:not(.eyebrow)]:text-muted max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-14 max-sm:pb-5 max-sm:[&_h1]:text-5xl max-sm:[&_h1]:leading-none max-sm:[&_>_p:not(.eyebrow)]:text-sm">
    <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
      ESTAMOS CERCA
    </p>
    <h1>
      Todo empieza
      <br />
      <em>con una conversación.</em>
    </h1>
    <p>
      Inspírate en nuestro Instagram.
      <br />
      Cuéntanos por WhatsApp qué te gustaría crear.
    </p>
    <SocialActions class="contact-actions mt-5" />
    <div class="mt-5">
      <a
        href="/personalizados"
        class="text-link inline-flex min-h-10 items-center gap-3 border-b border-solid border-line text-xs font-medium transition-colors hover:border-ink"
      >
        También puedes preparar tu solicitud <Icon name="arrow" size="sm" />
      </a>
    </div>
  </section>
  <DeliverySection />
  <section class="contact-note wrap mx-auto w-11/12 max-w-164 text-center pt-10 text-sm text-muted max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12 max-sm:text-xs">
    <p>
      Trabajamos mediante pedidos coordinados. Actualmente no contamos con un
      establecimiento físico abierto al público.
    </p>
  </section>
  <FAQ />
</Layout>
