---
import Layout from '../layouts/Layout.astro';
import DeliverySection from '../components/DeliverySection.astro';
import FAQ from '../components/FAQ.astro';
import { site } from '../config/site';
import { whatsappUrl } from '../lib/orders';
const contactUrl = whatsappUrl(
  site.whatsapp,
  'Hola, Frisson. Me gustaría conocer sus creaciones.',
);
---

<Layout title="Contacto y entregas — Frisson">
  <section class="page-intro wrap mx-auto w-11/12 max-w-7xl text-center pt-20 pb-8 [&_h1]:text-8xl [&_h1]:mb-7 [&_>_p:not(.eyebrow)]:text-sm [&_>_p:not(.eyebrow)]:leading-loose [&_>_p:not(.eyebrow)]:text-muted [&_.button]:mt-5 max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-14 max-sm:pb-5 max-sm:[&_h1]:text-5xl max-sm:[&_h1]:leading-none max-sm:[&_>_p:not(.eyebrow)]:text-sm">
    <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
      ESTAMOS CERCA
    </p>
    <h1>
      Todo empieza
      <br />
      <em>con una conversación.</em>
    </h1>
    <p>
      Cuéntanos qué tienes en mente.
      <br />
      Nos encantará darle forma con flores.
    </p>
    <div class="contact-actions gap-2.5 flex items-center flex-col [&_.field-note]:max-w-110 max-sm:[&_.field-note]:max-w-full">
      {contactUrl ? (
        <a
          class="button button-dark py-3 px-7 border border-solid border-olive gap-6 inline-flex justify-center items-center min-h-12 rounded-full bg-olive bg-none text-xs font-medium leading-normal transition duration-300 ease-out whitespace-nowrap text-paper [&:hover]:border-ink [&:hover]:bg-ink [&:hover]:bg-none [&:hover]:text-paper [&:hover]:-translate-y-0.5 max-sm:px-6 max-sm:min-h-11 max-sm:text-xs"
          href={contactUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Conversar por WhatsApp ↗
        </a>
      ) : (
        <p class="field-note text-xs text-muted leading-relaxed mt-5 max-sm:text-xs">
          Nuestro canal de WhatsApp estará disponible pronto. Mientras tanto,
          puedes preparar y copiar tu solicitud.
        </p>
      )}
      <a
        href="/personalizados"
        class="button py-3 px-7 border border-solid border-ink gap-6 inline-flex justify-center items-center min-h-12 rounded-full bg-paper bg-none text-xs font-medium leading-normal transition duration-300 ease-out whitespace-nowrap [&:hover]:bg-ink [&:hover]:bg-none [&:hover]:text-paper [&:hover]:-translate-y-0.5 max-sm:px-6 max-sm:min-h-11 max-sm:text-xs"
      >
        Preparar mi solicitud →
      </a>
    </div>
  </section>
  <DeliverySection />
  <section class="contact-note wrap mx-auto w-11/12 max-w-164 text-center pt-10 text-sm text-muted max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12 max-sm:text-xs">
    <p>
      Trabajamos mediante pedidos coordinados. Actualmente no contamos con un
      establecimiento físico abierto al público.
    </p>
  </section>
  <FAQ />
</Layout>
