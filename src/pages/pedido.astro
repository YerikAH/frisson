---
import Layout from '../layouts/Layout.astro';
import OrderForm from '../components/OrderForm.astro';
---

<Layout title="Prepara tu solicitud — Frisson" noindex>
  <section class="page-intro wrap mx-auto w-11/12 max-w-7xl text-center pt-20 pb-8 [&_h1]:text-8xl [&_h1]:mb-7 [&_>_p:not(.eyebrow)]:text-sm [&_>_p:not(.eyebrow)]:leading-loose [&_>_p:not(.eyebrow)]:text-muted [&_.button]:mt-5 max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-14 max-sm:pb-5 max-sm:[&_h1]:text-5xl max-sm:[&_h1]:leading-none max-sm:[&_>_p:not(.eyebrow)]:text-sm">
    <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
      DE UN GESTO A UN RECUERDO
    </p>
    <h1>
      Un detalle más.
      <br />
      <em>Y que florezca.</em>
    </h1>
    <p>
      Completa los detalles para preparar tu solicitud.
      <br />
      Confirmaremos contigo la disponibilidad y el importe.
    </p>
  </section>
  <section class="form-page wrap section mx-auto gap-24 w-11/12 max-w-7xl pt-12 pb-25 grid grid-cols-2 items-start max-xl:gap-14 max-xl:w-11/12 max-lg:py-20 max-lg:gap-9 max-lg:w-11/12 max-lg:grid-cols-2 max-sm:gap-9 max-sm:w-11/12 max-sm:pt-6 max-sm:pb-15 max-sm:flex max-sm:flex-col max-sm:[&_.order-form]:w-full">
    <aside class="order-summary p-8 sticky top-9 bg-pale/40 bg-none rounded-xs [&_>_p]:text-sm [&_>_p]:text-muted [&_h2]:text-4xl [&_.cart-row]:grid-cols-[auto_1fr] [&_.cart-row_img]:w-15 [&_.cart-row_img]:h-20 [&_.cart-row_h3]:text-xl [&_>_.text-link]:text-xs [&_>_.text-link]:mt-5 max-lg:p-5 max-lg:[&_.cart-row]:gap-2.5 max-lg:[&_.cart-row]:grid-cols-[auto_1fr] max-lg:[&_.cart-row_img]:w-11 max-lg:[&_.cart-row_h3]:text-lg max-sm:p-6 max-sm:static max-sm:w-full max-sm:[&_.cart-row]:grid-cols-[auto_1fr] max-sm:[&_.cart-row_img]:w-15 max-sm:[&_.cart-row_h3]:text-2xl">
      <h2>Tu selección</h2>
      <div id="page-order-items"></div>
      <a
        href="/catalogo"
        class="text-link gap-4 inline-flex items-center min-h-10 text-sm font-medium border-b border-solid border-b-line transition-all duration-200 [&:hover]:border-ink [&:hover]:gap-6"
      >
        Añadir otra creación →
      </a>
      <p class="field-note text-xs text-muted leading-relaxed mt-5 max-sm:text-xs">
        Los importes y el costo de entrega se confirman directamente con
        Frisson. No se realizan cobros desde esta web.
      </p>
    </aside>
    <OrderForm />
  </section>
</Layout>
