---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Esta flor aún no ha abierto — Frisson" noindex>
  <section class="page-intro wrap section mx-auto w-11/12 max-w-7xl pt-20 pb-8 text-center [&_h1]:text-8xl [&_h1]:mb-7 [&_>_p:not(.eyebrow)]:text-sm [&_>_p:not(.eyebrow)]:leading-loose [&_>_p:not(.eyebrow)]:text-muted [&_.button]:mt-5 max-xl:w-11/12 max-lg:py-20 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-14 max-sm:pb-5 max-sm:[&_h1]:text-5xl max-sm:[&_h1]:leading-none max-sm:[&_>_p:not(.eyebrow)]:text-sm">
    <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
      404 · UNA PAUSA EN EL CAMINO
    </p>
    <h1>
      Esta flor
      <br />
      <em>aún no ha abierto.</em>
    </h1>
    <p>No encontramos la página que buscas.</p>
    <a
      class="button button-dark py-3 px-7 border border-solid border-olive gap-6 inline-flex justify-center items-center min-h-12 rounded-full bg-olive bg-none text-xs font-medium leading-normal transition duration-300 ease-out whitespace-nowrap text-paper [&:hover]:border-ink [&:hover]:bg-ink [&:hover]:bg-none [&:hover]:text-paper [&:hover]:-translate-y-0.5 max-sm:px-6 max-sm:min-h-11 max-sm:text-xs"
      href="/"
    >
      Volver a Frisson →
    </a>
  </section>
</Layout>
