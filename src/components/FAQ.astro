---
import Icon from './Icon.astro';
import { questions } from '../data/faq';
---

<section
  class="faq section wrap mx-auto gap-20 w-11/12 max-w-5xl pt-30 pb-20 grid grid-cols-2 [&_h2]:text-5xl [&_h2]:max-w-80 [&_>_div_>_p:not(.eyebrow)]:text-sm [&_>_div_>_p:not(.eyebrow)]:text-muted [&_>_div_>_p:not(.eyebrow)]:leading-loose max-xl:gap-12 max-xl:w-11/12 max-lg:py-20 max-lg:gap-9 max-lg:w-11/12 max-lg:grid-cols-2 max-lg:[&_h2]:text-4xl max-sm:gap-6 max-sm:w-11/12 max-sm:pt-15 max-sm:pb-8 max-sm:grid-cols-1 max-sm:[&_h2]:text-4xl max-sm:[&_h2]:max-w-none max-sm:[&_h2]:mb-4 max-sm:[&_>_div_>_p:not(.eyebrow)]:text-xs"
  id="preguntas"
  aria-labelledby="faq-title"
>
  <div>
    <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
      CONVERSEMOS CON CALMA
    </p>
    <h2 id="faq-title">
      Quizá te <em>preguntes…</em>
    </h2>
    <p>
      Cada detalle merece una respuesta.
      <br />
      Estamos para acompañar tu elección.
    </p>
  </div>
  <div class="faq-list [&_details]:border-b [&_details]:border-solid [&_details]:border-b-line [&_details:first-child]:border-t [&_details:first-child]:border-solid [&_details:first-child]:border-t-line [&_summary]:py-5 [&_summary]:px-0 [&_summary]:gap-5 [&_summary]:flex [&_summary]:items-center [&_summary]:justify-between [&_summary]:text-sm [&_summary]:list-none [&_details_p]:text-sm [&_details_p]:leading-loose [&_details_p]:pr-8 [&_details_p]:text-muted [&_details_p]:mb-6 max-lg:[&_summary]:text-xs max-sm:[&_summary]:py-5 max-sm:[&_summary]:text-xs max-sm:[&_details_p]:text-xs">
    {questions.map(([q, a]) => (
      <details>
        <summary>
          {q}
          <Icon name="plus" size="sm" />
        </summary>
        <div data-details-body>
          <p>{a}</p>
        </div>
      </details>
    ))}
  </div>
</section>
