---
import Icon from './Icon.astro';
import ScrollHeader from './ScrollHeader';
import BrandLogo from './BrandLogo.astro';
import { site } from '../config/site';
import { normalizePathname } from '../lib/seo';
import { whatsappUrl } from '../lib/orders';

const contactUrl = whatsappUrl(
  site.whatsapp,
  'Hola, Frisson. Me gustaría conocer sus creaciones y hacer una consulta.',
);
const path = normalizePathname(Astro.url.pathname);
const catalogCurrent =
  path === '/catalogo'
    ? 'page'
    : path.startsWith('/catalogo/')
      ? 'location'
      : undefined;
---

<div class="h-32 max-sm:h-28">
  <ScrollHeader client:load>
    <header class="header [&[data-nav-indicator]_.nav-left_a::after]:opacity-0 [&[data-nav-indicator]_.history-link::after]:opacity-0 wrap mx-auto w-11/12 max-w-5xl h-32 grid grid-cols-[1fr_auto_1fr] relative items-center z-10 transition-[height] duration-300 ease-floral group-data-[scrolled=true]/scroll-header:h-18 motion-reduce:transition-none max-xl:w-11/12 max-xl:grid-cols-[1fr_auto_1fr] max-lg:w-11/12 max-lg:grid-cols-[1fr_auto_1fr] max-sm:w-11/12 max-sm:h-28 max-sm:group-data-[scrolled=true]/scroll-header:h-16 max-sm:grid-cols-[1fr_auto_1fr] max-sm:[&_.menu-toggle]:w-10 max-xs:grid-cols-[1fr_auto_1fr]">
      <button
        class="icon-button menu-toggle hidden items-center justify-center w-12 h-12 rounded-full transition-colors duration-200 [&:hover]:bg-pale [&:hover]:bg-none max-lg:inline-flex max-lg:justify-self-start max-sm:[&_svg]:w-6 max-sm:[&_svg]:h-6"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-haspopup="dialog"
      >
        <Icon name="menu" />
      </button>
      <nav
        class="nav-left gap-9 flex items-center text-xs [&_a]:py-3 [&_a]:relative [&_a::after]:content-[''] [&_a::after]:absolute [&_a::after]:left-0 [&_a::after]:right-full [&_a::after]:bottom-2 [&_a::after]:h-0.5 [&_a::after]:bg-ink [&_a::after]:bg-none [&_a::after]:transition-all [&_a::after]:duration-300 [&_a:hover::after]:right-0 [&_a[aria-current]::after]:right-0 [&_a.active::after]:right-0 max-xl:gap-5 max-xl:text-xs max-lg:hidden"
        aria-label="Navegación principal"
      >
        <a href="/#flores" aria-current={path === '/' ? 'location' : undefined}>
          Flores
        </a>
        <a href="/catalogo" aria-current={catalogCurrent}>
          Catálogo
        </a>
        <a href="/#colecciones">Colecciones</a>
      </nav>
      <a
        class:list={[
          'wordmark flex h-full w-96 items-center justify-center bg-none transition-colors duration-300 motion-reduce:transition-none max-xl:w-80 max-lg:w-64 max-sm:w-40',
          {
            'bg-hero-tint max-sm:bg-transparent group-data-[scrolled=true]/scroll-header:bg-transparent':
              path === '/',
          },
        ]}
        href="/"
        aria-label="Frisson, inicio"
      >
        <BrandLogo />
      </a>
      <div class="nav-right gap-4 flex items-center text-xs justify-end max-xl:gap-1 max-sm:gap-0 max-sm:[&_.icon-button]:w-10">
        <a
          class="history-link py-3 relative mr-6 [&::after]:content-[''] [&::after]:absolute [&::after]:left-0 [&::after]:right-full [&::after]:bottom-2 [&::after]:h-0.5 [&::after]:bg-ink [&::after]:bg-none [&::after]:transition-all [&::after]:duration-300 [&:hover::after]:right-0 [&[aria-current]::after]:right-0 max-xl:mr-1.5 max-xl:text-xs max-lg:hidden"
          href="/#historia"
          aria-current={path === '/historia' ? 'location' : undefined}
        >
          Nuestra historia
        </a>
        {site.instagram && (
          <a
            class="icon-button inline-flex size-12 items-center justify-center rounded-full transition-colors duration-200 hover:bg-pale max-sm:hidden"
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Síguenos en Instagram"
            title="Instagram de Frisson"
          >
            <Icon name="instagram" />
          </a>
        )}
        <button
          class="icon-button inline-flex items-center justify-center w-12 h-12 rounded-full transition-colors duration-200 [&:hover]:bg-pale [&:hover]:bg-none max-sm:[&_svg]:w-6 max-sm:[&_svg]:h-6"
          data-open-search
          aria-label="Buscar arreglos"
          aria-haspopup="dialog"
          aria-controls="search-dialog"
        >
          <Icon name="search" />
        </button>
        <button
          class="icon-button bag-button inline-flex items-center justify-center w-12 h-12 rounded-full transition-colors duration-200 relative [&:hover]:bg-pale [&:hover]:bg-none max-sm:[&_svg]:w-6 max-sm:[&_svg]:h-6"
          data-open-cart
          aria-label="Abrir mi selección"
          aria-haspopup="dialog"
          aria-controls="cart-dialog"
        >
          <Icon name="bag" />
          <span
            class="cart-count absolute top-0 right-0 text-xs bg-olive bg-none text-paper rounded-full w-4 h-4 leading-4 text-center"
            hidden
          >
            0
          </span>
        </button>
      </div>
    </header>
  </ScrollHeader>
</div>
<dialog
  id="mobile-menu"
  class="mobile-menu fixed inset-0 m-0 h-screen w-screen max-h-none max-w-none overflow-x-hidden overflow-y-auto overscroll-contain rounded-none border-0 bg-paper p-0 text-ink supports-[height:100dvh]:h-dvh [scroll-padding-top:8rem]"
  aria-label="Menú móvil de Frisson"
>
  <div class="mobile-menu-shell flex min-h-full flex-col px-7 sm:px-12">
    <div class="mobile-menu-head sticky top-0 z-10 flex items-start justify-between gap-6 bg-paper pb-5 pt-[max(1.5rem,env(safe-area-inset-top))]">
      <a
        class="mobile-menu-brand inline-flex"
        href="/"
        aria-label="Frisson, inicio"
      >
        <BrandLogo class="[&>span:first-child]:h-10 [&>span:first-child]:w-7" />
      </a>
      <button
        class="inline-flex size-12 shrink-0 items-center justify-center rounded-full transition-colors duration-200 hover:bg-pale"
        data-close-menu
        aria-label="Cerrar menú"
        autofocus
      >
        <Icon name="close" />
      </button>
    </div>
    <nav class="mobile-menu-links my-auto py-4" aria-label="Menú móvil">
      {[
        {
          name: 'Flores',
          href: '/#flores',
          current: path === '/' ? 'location' : undefined,
        },
        { name: 'Catálogo', href: '/catalogo', current: catalogCurrent },
        { name: 'Colecciones', href: '/#colecciones' },
        {
          name: 'Crea tu arreglo',
          href: '/personalizados',
          current: path === '/personalizados' ? 'page' : undefined,
        },
        {
          name: 'Nuestra historia',
          href: '/historia',
          current: path === '/historia' ? 'page' : undefined,
        },
        {
          name: 'Contacto y entregas',
          href: '/contacto',
          current: path === '/contacto' ? 'page' : undefined,
        },
      ].map((item, index) => (
        <a
          class="mobile-menu-link group relative flex items-baseline gap-4 py-2.5 transition-colors duration-200 hover:text-olive aria-[current]:text-olive max-[400px]:py-2"
          href={item.href}
          aria-current={item.current as 'page' | 'location' | undefined}
        >
          <span
            data-menu-index
            class="w-5 shrink-0 font-sans text-[10px] tracking-widest text-muted"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          <span
            data-menu-text
            class="font-serif text-[clamp(1.8rem,4.8dvh,2.75rem)] leading-tight tracking-tight max-[400px]:text-[clamp(1.5rem,7vw,1.75rem)]"
          >
            {item.name}
          </span>
          <span
            data-menu-line
            class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left bg-line"
            aria-hidden="true"
          ></span>
        </a>
      ))}
    </nav>
    <div class="mobile-menu-footer flex flex-wrap gap-x-6 gap-y-0 border-t border-solid border-line pt-3 pb-[max(1.25rem,env(safe-area-inset-bottom))] text-xs">
      {site.instagram && (
        <a
          class="inline-flex min-h-11 items-center gap-2.5"
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="instagram" size="sm" /> Síguenos en Instagram
        </a>
      )}
      {contactUrl && (
        <a
          class="inline-flex min-h-11 items-center gap-2.5"
          href={contactUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size="sm" /> Escríbenos por WhatsApp
        </a>
      )}
    </div>
  </div>
</dialog>
