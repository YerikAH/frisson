---
import {
  ArrowDown,
  ArrowRight,
  ArrowUp,
  ArrowUpRight,
  Check,
  Flower2,
  Heart,
  Leaf,
  MapPin,
  Menu,
  Plus,
  Search,
  ShoppingBag,
  Sparkles,
  Truck,
  X,
} from '@lucide/astro';
import { siInstagram, siWhatsapp } from 'simple-icons';

const icons = {
  arrow: ArrowRight,
  down: ArrowDown,
  up: ArrowUp,
  'up-right': ArrowUpRight,
  search: Search,
  bag: ShoppingBag,
  plus: Plus,
  close: X,
  menu: Menu,
  flower: Flower2,
  leaf: Leaf,
  sparkle: Sparkles,
  delivery: Truck,
  check: Check,
  heart: Heart,
  pin: MapPin,
};
const brands = { whatsapp: siWhatsapp, instagram: siInstagram };

interface Props {
  name: keyof typeof icons | keyof typeof brands;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { name, size = 'md', class: className } = Astro.props;
const sizes = { sm: 'size-4', md: 'size-5', lg: 'size-7' };
const iconClass = [sizes[size], 'shrink-0', className]
  .filter(Boolean)
  .join(' ');
const brand = name in brands ? brands[name as keyof typeof brands] : undefined;
const Glyph = name in icons ? icons[name as keyof typeof icons] : undefined;
---

{brand ? (
  <svg
    class={iconClass}
    data-icon={name}
    viewBox="0 0 24 24"
    fill="currentColor"
    stroke="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d={brand.path} />
  </svg>
) : (
  Glyph && (
    <Glyph
      class={iconClass}
      data-icon={name}
      stroke-width={1.5}
      aria-hidden="true"
      focusable="false"
    />
  )
)}
