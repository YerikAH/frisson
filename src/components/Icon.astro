---
interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { name, size = 'md', class: className } = Astro.props;
const sizes = { sm: 'size-4', md: 'size-5', lg: 'size-7' };
const paths: Record<string, string> = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  down: 'M12 4v16m-6-6 6 6 6-6',
  search: 'M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  bag: 'M5 7h14l1 14H4L5 7Zm3 0V5a4 4 0 0 1 8 0v2',
  plus: 'M12 5v14M5 12h14',
  close: 'm6 6 12 12M6 18 18 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  whatsapp:
    'M21 11.5a9 9 0 0 1-13.6 7.7L3 21l1.7-4.9A9 9 0 1 1 21 11.5ZM8.6 7.3c-.6 0-1 .5-1 1.2 0 3.1 3.8 6.9 6.9 6.9.7 0 1.2-.4 1.2-1l-1.8-1-1 1c-1.6-.7-2.9-2-3.6-3.6l1-1-1-2.5Z',
  flower:
    'M12 8c-5-9-11 0-5 3-9 3-2 11 3 5 1 9 10 5 6-1 9 1 7-9 1-8 2-8-8-10-8-2Zm0 1a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  leaf: 'M20 3C8 2 2 7 5 15s15 7 15-12ZM5 20 16 9M8 17l-1-6m6 1 5 1',
  sparkle: 'm12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z',
  delivery:
    'M3 6h11v12H3V6Zm11 5h4l3 4v3h-7M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm12 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  check: 'm5 12 4 4L19 6',
  heart:
    'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z',
  pin: 'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Zm-5 0a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z',
};
---

<svg
  class:list={[sizes[size], className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.arrow} />
</svg>
