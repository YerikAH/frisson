---
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import { products } from '../data/products';
---

<section
  class="collections section wrap mx-auto w-11/12 max-w-7xl pt-24 pb-14 max-xl:w-11/12 max-lg:py-20 max-lg:w-11/12 max-sm:w-11/12 max-sm:pt-15 max-sm:pb-5"
  id="colecciones"
>
  <div class="section-heading gap-6 flex justify-between items-end mb-12 [&_h2]:m-0 [&_>_.button]:mb-2.5 max-lg:mb-9 max-lg:[&_h2]:text-4xl max-lg:[&_.button]:px-5 max-lg:[&_.button]:gap-3 max-lg:[&_.button]:text-xs max-sm:gap-6 max-sm:items-start max-sm:flex-col max-sm:mb-8 max-sm:[&_h2]:text-4xl max-sm:[&_>_.button]:m-0 max-sm:[&_>_.button]:py-2 max-sm:[&_>_.button]:px-5 max-sm:[&_>_.button]:gap-5 max-sm:[&_>_.button]:text-xs max-sm:[&_>_.button]:min-h-9">
    <div>
      <p class="eyebrow text-xs font-medium tracking-widest leading-relaxed mb-6 text-olive max-sm:text-xs max-sm:mb-4 max-sm:tracking-widest">
        EL LENGUAJE DE LAS FLORES
      </p>
      <h2>
        Descubre nuestras
        <br />
        <em>creaciones.</em>
      </h2>
    </div>
    <a
      href="/catalogo"
      class="button py-3 px-7 border border-solid border-ink gap-6 inline-flex justify-center items-center min-h-12 rounded-full bg-paper bg-none text-xs font-medium leading-normal transition duration-300 ease-out whitespace-nowrap [&:hover]:bg-ink [&:hover]:bg-none [&:hover]:text-paper [&:hover]:-translate-y-0.5 max-sm:px-6 max-sm:min-h-11 max-sm:text-xs"
    >
      Ver toda la colección <Icon name="arrow" size="sm" />
    </a>
  </div>
  <div class="product-grid gap-8 grid grid-cols-4 max-xl:gap-6 max-lg:gap-5 max-sm:grid-cols-2 max-sm:gap-y-9 max-sm:gap-x-5">
    {products.slice(0, 4).map((product, index) => (
      <ProductCard product={product} index={index} />
    ))}
  </div>
  <p class="catalog-note mx-0 text-center text-xs text-muted mt-10 mb-0 max-sm:text-xs max-sm:leading-relaxed max-sm:mt-7">
    Fotografías de nuestras creaciones. Una inspiración para tu próximo gesto;
    cada ramo se compone especialmente para ti.
  </p>
</section>
