---
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { site } from '../config/site';
import { whatsappUrl } from '../lib/orders';
const contactUrl = whatsappUrl(
  site.whatsapp,
  'Hola, Frisson. Me gustaría conocer sus creaciones.',
);
---

<footer class="footer px-0 bg-footer bg-none text-ivory pt-16 pb-24 [&_h2]:mx-0 [&_h2]:font-sans [&_h2]:text-xs [&_h2]:tracking-normal [&_h2]:leading-relaxed [&_h2]:mt-3 [&_h2]:mb-5 max-sm:pt-10 max-sm:[&_h2]:mx-0 max-sm:[&_h2]:text-xs max-sm:[&_h2]:mt-0 max-sm:[&_h2]:mb-4">
  <div class="wrap mx-auto w-11/12 max-w-5xl max-xl:w-11/12 max-lg:w-11/12 max-sm:w-11/12">
    <div class="footer-grid gap-9 grid grid-cols-5 pb-16 [&_>_div:not(.footer-brand)_>_a]:block [&_>_div:not(.footer-brand)_>_a]:text-xs [&_>_div:not(.footer-brand)_>_a]:text-footer-muted [&_>_div:not(.footer-brand)_>_a]:mb-2.5 [&_a:not(.footer-wordmark):hover]:underline [&_a:hover]:underline-offset-1.5 max-xl:gap-6 max-xl:grid-cols-5 max-lg:grid-cols-3 max-lg:gap-y-6 max-lg:gap-x-10 max-lg:[&_>_div:last-child]:col-start-3 max-sm:grid-cols-2 max-sm:gap-y-8 max-sm:gap-x-6 max-sm:pb-9 max-sm:[&_>_div:last-child]:col-auto max-sm:[&_>_div:not(.footer-brand)_>_a]:text-xs">
      <div class="footer-brand max-lg:row-span-2 max-sm:row-auto max-sm:col-span-full max-sm:grid max-sm:grid-cols-[auto_1fr] max-sm:items-center max-sm:gap-x-6 max-sm:gap-y-4">
        <a
          class="footer-wordmark inline-flex"
          href="/"
          aria-label="Frisson, inicio"
        >
          <BrandLogo variant="stacked" />
        </a>
        <p class="mt-3 mb-5 max-w-48 text-sm leading-relaxed max-sm:m-0">
          {site.slogan}
        </p>
        <span class="block text-xs tracking-wider text-footer-muted max-sm:col-span-full">
          Flores de autor. Emociones de verdad.
        </span>
      </div>
      <div>
        <h2>Explorar</h2>
        <a href="/">Inicio</a>
        <a href="/catalogo">Catálogo</a>
        <a href="/#colecciones">Colecciones</a>
        <a href="/personalizados">Personalizados</a>
      </div>
      <div>
        <h2>La marca</h2>
        <a href="/historia">Nuestra historia</a>
        <a href="/historia#inspiracion">Inspiración</a>
        <a href="/#comunidad">Nuestro universo</a>
        <a href="/#preguntas">Preguntas frecuentes</a>
      </div>
      <div>
        <h2>Cerca de ti</h2>
        <a href="/contacto">Contacto</a>
        {contactUrl && (
          <a href={contactUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        )}
        {site.instagram && (
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        )}
        {site.tiktok && (
          <a href={site.tiktok} target="_blank" rel="noopener noreferrer">
            TikTok
          </a>
        )}
        <a href="/#delivery">Zonas de entrega</a>
        <a href="/#como-pedir">Cómo hacer un pedido</a>
      </div>
      <div class="footer-journal [&_p]:text-xs [&_p]:leading-relaxed [&_p]:text-footer-muted [&_.footer-journal-link]:py-3 [&_.footer-journal-link]:px-0 [&_.footer-journal-link]:flex! [&_.footer-journal-link]:items-center [&_.footer-journal-link]:justify-between [&_.footer-journal-link]:border-b [&_.footer-journal-link]:border-solid [&_.footer-journal-link]:border-b-footer-muted/60 max-sm:[&_p]:text-xs max-sm:[&_.footer-journal-link]:text-xs!">
        <h2>Sigamos cerca</h2>
        <p>
          Flores, historias y pequeños instantes en Instagram. Te esperamos en
          @frisson.pee.
        </p>
        {site.instagram && (
          <a
            class="footer-journal-link"
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            Síguenos en Instagram <Icon name="instagram" size="sm" />
          </a>
        )}
      </div>
    </div>
    <div class="footer-bottom gap-5 border-t border-solid border-t-footer-muted/40 pt-5 flex justify-between items-center text-xs text-footer-muted [&_p]:m-0 [&_>_div]:gap-5 [&_>_div]:flex [&_a:hover]:text-white max-lg:flex-wrap max-lg:text-xs max-sm:gap-5 max-sm:text-xs max-sm:[&_>_div]:gap-4 max-sm:[&_>_a]:ml-auto">
      <p>© {new Date().getFullYear()} Frisson. Hecho con alma en Huancayo.</p>
      <div>
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos e información comercial</a>
      </div>
      <a
        href="#inicio"
        aria-label="Volver al inicio"
        class="inline-flex items-center gap-2"
      >
        Volver arriba <Icon name="up" size="sm" />
      </a>
    </div>
  </div>
</footer>
